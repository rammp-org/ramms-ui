// RammsUI Outline Shader Utilities
// Common types and helpers for the outline system.
// Include via: #include "/RammsUI/Private/RammsOutlineCommon.ush"
//
// All functions accept Viewport UV (the UV from ScreenPosition / TexCoord
// in your Custom node).  Internally they convert to Buffer UV via
// ViewportUVToBufferUV() before sampling scene textures.
//
// ── Scene Texture Access ───────────────────────────────────────────
//
// By default, sampling uses CalcSceneCustomDepth / CalcSceneCustomStencil /
// CalcSceneDepth from UE's SceneTexturesCommon.ush.  These wrappers are
// platform-aware (they select SceneTexturesStruct on desktop and
// MobileSceneTextures on mobile internally), but the material compiler
// cannot track dependencies hidden inside #included HLSL — it only
// inspects the material expression graph.  On mobile Vulkan this means
// the textures may not be bound and render-pass barriers may be missing,
// which can break decals and other stencil-dependent features.
//
// To fix this, wire SceneTexture expression nodes into the Custom node
// as **float / color inputs** (the only output types SceneTexture nodes
// support).  The HLSL code does not need to read those inputs; the
// *connection* alone forces the material compiler to register the scene-
// texture dependencies so the correct bindings and barriers are emitted
// for every target platform.
//
//   Material graph wiring (add as Custom node inputs):
//     SceneTexture(Custom Depth)   → _DepthRef   (float, unused in code)
//     SceneTexture(Custom Stencil) → _StencilRef  (float, unused in code)
//     SceneTexture(Scene Depth)    → _SceneDepthRef (float, unused if
//                                     not using depth-aware outlines)
//
// With those connections the default RAMMS_SAMPLE_* macros (CalcScene*)
// work correctly on all platforms.
//
// If you need to replace the sampling entirely (e.g. reading from a
// render-target copy instead of the live buffers), override the macros
// BEFORE including this file:
//
//   #define RAMMS_SAMPLE_CUSTOM_DEPTH(BufUV)    MyDepthTex.SampleLevel(MySamp, BufUV, 0).r
//   #define RAMMS_SAMPLE_CUSTOM_STENCIL(Pixel)  (int)(MyStencilTex.Load(int3(Pixel, 0)).r)
//   #define RAMMS_SAMPLE_SCENE_DEPTH(BufUV)     MySceneDepthTex.SampleLevel(MySamp, BufUV, 0).r
//   #include "/RammsUI/Private/RammsOutline.usf"

#pragma once

// ── Stencil Outline Configuration ──────────────────────────────────

#define RAMMS_MAX_OUTLINE_PROFILES 8

// ── Scene Texture Sampling Macros ──────────────────────────────────
// Override these BEFORE including this header to control where depth /
// stencil reads come from.  Defaults use UE's built-in CalcScene*
// functions (desktop-only safe).

#ifndef RAMMS_SAMPLE_CUSTOM_DEPTH
#define RAMMS_SAMPLE_CUSTOM_DEPTH(BufUV) CalcSceneCustomDepth(BufUV)
#endif

#ifndef RAMMS_SAMPLE_CUSTOM_STENCIL
#define RAMMS_SAMPLE_CUSTOM_STENCIL(Pixel) CalcSceneCustomStencil(Pixel)
#endif

#ifndef RAMMS_SAMPLE_SCENE_DEPTH
#define RAMMS_SAMPLE_SCENE_DEPTH(BufUV) CalcSceneDepth(BufUV)
#endif

// ── Internal Helpers ───────────────────────────────────────────────

// Viewport texel size — one pixel step in viewport UV space.
float2 Ramms_GetTexelSize()
{
	return View_ViewSizeAndInvSize.zw;
}

// ── Sampling Helpers ───────────────────────────────────────────────
// All accept Viewport UV, convert to Buffer UV internally.
// Actual texture reads go through the RAMMS_SAMPLE_* macros above.

float Ramms_SampleCustomDepth(float2 ViewportUV)
{
	float2 BufUV = ViewportUVToBufferUV(ViewportUV);
	float WorldDepth = RAMMS_SAMPLE_CUSTOM_DEPTH(BufUV);
	return (WorldDepth > 1e6f) ? 0.0f : WorldDepth;
}

int Ramms_SampleStencilInt(float2 ViewportUV)
{
	float2 BufUV = ViewportUVToBufferUV(ViewportUV);
	uint2 Pixel = (uint2)(int2(BufUV * View_BufferSizeAndInvSize.xy));
	return (int)RAMMS_SAMPLE_CUSTOM_STENCIL(Pixel);
}

float Ramms_SampleSceneDepth(float2 ViewportUV)
{
	float2 BufUV = ViewportUVToBufferUV(ViewportUV);
	return RAMMS_SAMPLE_SCENE_DEPTH(BufUV);
}

// ── Edge Detection Kernels ─────────────────────────────────────────

float Ramms_RobertsCrossDepth(float2 UV, float2 TexelSize)
{
	float d00 = Ramms_SampleCustomDepth(UV + float2(-0.5, -0.5) * TexelSize);
	float d11 = Ramms_SampleCustomDepth(UV + float2( 0.5,  0.5) * TexelSize);
	float d01 = Ramms_SampleCustomDepth(UV + float2(-0.5,  0.5) * TexelSize);
	float d10 = Ramms_SampleCustomDepth(UV + float2( 0.5, -0.5) * TexelSize);

	float gx = d00 - d11;
	float gy = d01 - d10;

	return sqrt(gx * gx + gy * gy);
}

float Ramms_SobelStencil(float2 UV, float2 TexelSize)
{
	int c  = Ramms_SampleStencilInt(UV);
	int n  = Ramms_SampleStencilInt(UV + float2( 0,  1) * TexelSize);
	int s  = Ramms_SampleStencilInt(UV + float2( 0, -1) * TexelSize);
	int e  = Ramms_SampleStencilInt(UV + float2( 1,  0) * TexelSize);
	int w  = Ramms_SampleStencilInt(UV + float2(-1,  0) * TexelSize);
	int ne = Ramms_SampleStencilInt(UV + float2( 1,  1) * TexelSize);
	int nw = Ramms_SampleStencilInt(UV + float2(-1,  1) * TexelSize);
	int se = Ramms_SampleStencilInt(UV + float2( 1, -1) * TexelSize);
	int sw = Ramms_SampleStencilInt(UV + float2(-1, -1) * TexelSize);

	int diff = 0;
	diff += (c != n)  ? 1 : 0;
	diff += (c != s)  ? 1 : 0;
	diff += (c != e)  ? 1 : 0;
	diff += (c != w)  ? 1 : 0;
	diff += (c != ne) ? 1 : 0;
	diff += (c != nw) ? 1 : 0;
	diff += (c != se) ? 1 : 0;
	diff += (c != sw) ? 1 : 0;

	return saturate((float)diff / 3.0f);
}
